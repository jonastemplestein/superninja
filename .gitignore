# ---- Super Ninja: keep the repo to code, content and shipped assets ----
# bot/treadmill output (regenerable, gigabytes of screenshots)
playtest/runs/
playtest/.build/
playtest/hero/
playtest/.promote/
# bot screenshots, frame dumps and clips stay local (a handful of hand-picked stills are tracked explicitly)
playtest/**/*.png
playtest/**/*.jpg
playtest/**/*.jpeg
playtest/**/*.webp
playtest/**/*.mp4
playtest/**/*.webm
# raw art, video renders, caches (regenerable; shipped results live in public/)
assets-src/**
!assets-src/**/
!assets-src/**/*.ts
!assets-src/**/*.py
!assets-src/**/*.md
!assets-src/**/*.sh
!assets-src/**/*.json
assets-src/trailer/cache/
# third-party Sounds~Write documents downloaded for research: copyrighted, never publish
assets-src/sw-sources/
# secrets, just in case
.env*
*.pem

# per-machine Claude Code settings (status line for the wake watchdog)
.claude/settings.local.json

# discarded files (moved here instead of rm, so nothing needs approval and everything is recoverable)
.trash/
playtest/**/.r2-prefix
playtest/showcase/
