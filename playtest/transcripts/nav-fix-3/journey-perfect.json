   },
   {
    "t": 0.2,
    "kind": "say",
    "who": "sensei",
    "text": "Long ago, on the Island of Sounds, there grew a magic World Flower.",
    "url": "/a/l/film_1.mp3"
   },
   {
    "t": 6.2,
    "kind": "hold",
    "text": "film 1/8, 0.0 s"
   },
   {
    "t": 6.2,
    "kind": "nav",
    "text": "Next"
   },
   {
    "t": 6.3,
    "kind": "say",
    "who": "sensei",
    "text": "Every petal was a sound. With sounds, we could talk, and read, and sing!",
    "url": "/a/l/film_2.mp3"
   },
   {
    "t": 12.3,
    "kind": "hold",
    "text": "film 2/8, 0.0 s"
